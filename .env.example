# Copy this file to .env and fill in your actual RDS values.
PORT=3000
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_NAME=feedback
DB_USER=feedback_app
DB_PASSWORD=awspassword123
DB_SSL=false
DB_POOL_MAX=10
SYNC_API_KEY=replace_with_a_long_random_api_key
# For RDS, set DB_SSL=true and DB_SSL_CA=/app/certs/global-bundle.pem after adding the AWS RDS CA bundle.
